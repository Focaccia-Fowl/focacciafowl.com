---
// The shop badge: an eagle perched on a loaf. The ring lettering only appears at sizes where it is legible.
interface Props { size?: number; class?: string; title?: string }
const { size = 120, class: cls, title } = Astro.props;
const lettered = size >= 110;
const uid = `ring-${Math.round(size)}`;
---
<svg class:list={["emblem", cls]} width={size} height={size} viewBox="0 0 120 120" role={title ? "img" : undefined} aria-hidden={title ? undefined : "true"}>
  {title && <title>{title}</title>}
  <circle cx="60" cy="60" r="58" fill="#fbf3e1" stroke="#8f3322" stroke-width="3" />
  <circle cx="60" cy="60" r={lettered ? 44 : 52} fill="#9cc9e3" />
  {lettered && (
    <>
      <defs><path id={uid} d="M60 60m-50 0a50 50 0 1 1 100 0a50 50 0 1 1-100 0" /></defs>
      <text font-family="Fraunces, Georgia, serif" font-weight="800" font-size="8.6" fill="#8f3322">
        <textPath href={`#${uid}`} startOffset="0" textLength="306" lengthAdjust="spacing">FOCACCIA FOWL · HALF BAKED PROJECTS · FRESH DAILY ·</textPath>
      </text>
    </>
  )}
  <g transform={lettered ? "translate(60 62) scale(0.78) translate(-60 -62)" : "translate(60 62) scale(0.92) translate(-60 -62)"}>
    <!-- loaf -->
    <rect x="22" y="78" width="76" height="24" rx="11" fill="#a3632a" />
    <rect x="24" y="74" width="72" height="20" rx="10" fill="#e6b15f" />
    <rect x="30" y="77" width="60" height="5" rx="2.5" fill="#f6d48a" opacity="0.8" />
    <ellipse cx="40" cy="87" rx="4" ry="2.4" fill="#bf8236" /><ellipse cx="60" cy="88" rx="4" ry="2.4" fill="#bf8236" /><ellipse cx="80" cy="87" rx="4" ry="2.4" fill="#bf8236" />
    <!-- eagle -->
    <ellipse cx="58" cy="54" rx="17" ry="22" fill="#5a4030" />
    <path d="M50 40c-9 9-12 22-8 35 9-3 16-12 18-26z" fill="#3f2c20" />
    <circle cx="64" cy="30" r="13" fill="#fdf8ec" />
    <path d="M75 27c7 0 12 3 13 8-4-1-7 0-8 3-4 0-6-3-7-6z" fill="#f2b84b" />
    <circle cx="69" cy="27" r="2.6" fill="#2a2622" />
    <path d="M52 74c-1 2-1 4 1 5h5c1-2 0-4-1-5zM63 74c-1 2-1 4 1 5h5c1-2 0-4-1-5z" fill="#f2b84b" />
  </g>
</svg>
