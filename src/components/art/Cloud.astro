---
// A big soft painted cloud. Colors follow the time of day through --cloud and --cloud-shade.
interface Props { size?: number; class?: string }
const { size = 200, class: cls } = Astro.props;
---
<svg class:list={["cloud", cls]} width={size} height={size * 0.5} viewBox="0 0 200 100" aria-hidden="true">
  <g fill="var(--cloud-shade)" transform="translate(0 7)">
    <rect x="18" y="52" width="164" height="36" rx="18" /><circle cx="58" cy="54" r="28" /><circle cx="102" cy="40" r="36" /><circle cx="146" cy="56" r="26" />
  </g>
  <g fill="var(--cloud)">
    <rect x="18" y="52" width="164" height="36" rx="18" /><circle cx="58" cy="54" r="28" /><circle cx="102" cy="40" r="36" /><circle cx="146" cy="56" r="26" />
  </g>
  <ellipse cx="92" cy="26" rx="18" ry="8" fill="#fff" opacity="0.35" />
</svg>
