---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import BakerStamp from "../../components/art/BakerStamp.astro";
import { visibleEntries, entrySlug, tagSlug } from "../../lib/bench.ts";

export async function getStaticPaths() {
  const entries = visibleEntries(await getCollection("bench"), import.meta.env.DEV);
  return entries.map((entry) => ({ params: { slug: entrySlug(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const dateText = entry.data.date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class="page container narrow">
    <p class="back"><a href="/bench/">Back to the bench</a></p>
    <header>
      <div>
        <p class="date"><time datetime={entry.data.date.toISOString()}>{dateText}</time></p>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.summary}</p>
      </div>
      <BakerStamp bakers={entry.data.bakers} size={84} />
    </header>
    {entry.data.cover && <Image class="cover" src={entry.data.cover} alt={entry.data.coverAlt ?? ""} width={820} />}
    <div class="body"><Content /></div>
    {entry.data.tags.length > 0 && <p class="tags">{entry.data.tags.map((t) => <a href={`/bench/tags/${tagSlug(t)}/`}>#{t}</a>)}</p>}
  </article>
</Base>
<style>
  .narrow { max-width: 760px; }
  .back { font-weight: 700; margin-bottom: 18px; }
  header { display: flex; justify-content: space-between; gap: 20px; align-items: flex-start; }
  .date { margin: 0; font-size: 0.85rem; font-weight: 700; color: var(--ink-soft); letter-spacing: 0.04em; text-transform: uppercase; }
  .cover { border-radius: 12px; border: 8px solid #fff; box-shadow: 0 8px 22px rgba(42, 38, 34, 0.2); margin: 12px 0 8px; }
  .body { margin-top: 20px; font-size: 1.08rem; }
  .body :global(h2) { margin-top: 2rem; color: var(--brick-deep); }
  .body :global(img) { border-radius: 10px; border: 6px solid #fff; box-shadow: 0 6px 16px rgba(42, 38, 34, 0.18); margin: 8px 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px 14px; font-weight: 700; margin-top: 28px; }
</style>
