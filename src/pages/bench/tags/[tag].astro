---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import BenchEntryCard from "../../../components/BenchEntryCard.astro";
import { visibleEntries, sortNewestFirst, allTags, tagSlug } from "../../../lib/bench.ts";

export async function getStaticPaths() {
  const entries = sortNewestFirst(visibleEntries(await getCollection("bench"), import.meta.env.DEV));
  return allTags(entries).map((t) => ({
    params: { tag: t.slug },
    props: { label: t.tag, entries: entries.filter((e) => e.data.tags.some((raw) => tagSlug(raw) === t.slug)) },
  }));
}
const { label, entries } = Astro.props;
---
<Base title={`#${label}`} description={`Bench entries tagged ${label}.`}>
  <div class="page container narrow">
    <p class="back"><a href="/bench/">Back to the bench</a></p>
    <p class="kicker">on the bench, tagged</p>
    <h1>#{label}</h1>
    <div class="list">{entries.map((entry) => <BenchEntryCard entry={entry} />)}</div>
  </div>
</Base>
<style>
  .narrow { max-width: 820px; }
  .back { font-weight: 700; margin-bottom: 18px; }
  .list { display: grid; gap: 18px; margin-top: 20px; }
</style>
